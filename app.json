{
  "expo": {
    "name": "Leadgen",
    "slug": "leadgen",
    "version": "1.0.0",
    "scheme": "leadgen",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "assets/icons/leadgenForeground.png",
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-notifications",
        {
          "color": "#111827"
        }
      ],
      "expo-sharing",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-web-browser"
    ],
    "android": {
      "package": "com.leadgen.app",
      "icon": "./assets/icons/leadgenForeground.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/leadgenForeground.png",
        "backgroundColor": "#FFFFFF",
        "backgroundImage": "./assets/icons/LeadgenAdaptiveBackground.png",
        "monochromeImage": "./assets/icons/leadgenForeground.png"
      }
    },
    "ios": {
      "bundleIdentifier": "com.leadgen.app"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b7e7f97c-f8f8-4a29-ad7b-620289402356"
      }
    }
  }
}
